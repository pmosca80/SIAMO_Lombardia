# Copia in .env e compila i valori.
# Su Railway questa variabile viene iniettata automaticamente dal servizio Postgres.
# Formato accettato: postgresql://... oppure postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/siamo_lombardia

# Configurazione applicazione
APP_NAME=SIAMO Lombardia
ENVIRONMENT=development
DEBUG=true

# Invio email. Priorità: Resend > Brevo SMTP > log (sviluppo).
#
# Resend (consigliato se non hai un dominio proprio autenticato: usa
# onboarding@resend.dev, già autenticato da Resend).
RESEND_API_KEY=
RESEND_FROM=SIAMO Lombardia <onboarding@resend.dev>

# Brevo SMTP relay (richiede un dominio proprio autenticato per una consegna
# affidabile su Gmail/Outlook: senza allineamento SPF/DKIM/DMARC le email
# possono essere scartate silenziosamente dal destinatario).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=SIAMO Lombardia

# Error tracking (opzionale). Se vuoto, Sentry resta disattivato.
SENTRY_DSN=

# Account siamoesercito.org con permesso di leggere gli allegati normative
# (richiesti da Drupal via login). Usato solo da scripts/import_normative.py.
SIAMOESERCITO_USERNAME=
SIAMOESERCITO_PASSWORD=
