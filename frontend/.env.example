# Copia in .env e compila i valori.
VITE_API_BASE_URL=http://localhost:8000

# Id dell'organizzazione (tenant) servita da questo frontend: si ottiene
# dalla risposta di POST /organizzazioni al primo avvio del backend.
VITE_ORGANIZZAZIONE_ID=1

# Error tracking (opzionale). Se vuoto, Sentry resta disattivato.
VITE_SENTRY_DSN=
